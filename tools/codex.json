{
  "id": "codex",
  "name": "OpenAI Codex CLI",
  "description": "OpenAI 官方命令行 AI 编码助手，支持在终端中与 AI 协作完成代码任务；当前通过 npm 全局安装，Windows 环境建议按官方 README 使用 WSL2。",
  "version": "latest",
  "homepage_url": "https://github.com/openai/codex",
  "install_docs_url": "https://github.com/openai/codex#readme",
  "detection": {
    "check_command": "codex --version",
    "version_regex": "(\\d+\\.\\d+\\.\\d+)"
  },
  "platforms": [
    {
      "os": "windows",
      "arch": null,
      "install_methods": [
        {
          "id": "npm",
          "label": "使用 npm 全局安装",
          "requires": [{"tool_id": "nodejs", "min_version": "22.0.0"}],
          "install_commands": ["npm install -g @openai/codex"],
          "uninstall_commands": ["npm uninstall -g @openai/codex"],
          "installed_check": "codex --version"
        }
      ]
    },
    {
      "os": "macos",
      "arch": null,
      "install_methods": [
        {
          "id": "npm",
          "label": "使用 npm 全局安装",
          "requires": [{"tool_id": "nodejs", "min_version": "22.0.0"}],
          "install_commands": ["npm install -g @openai/codex"],
          "uninstall_commands": ["npm uninstall -g @openai/codex"],
          "installed_check": "codex --version"
        }
      ]
    }
  ]
}
